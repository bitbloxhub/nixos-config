+void CFingerprint::scheduleVerifyRetry(bool recreateDevice, int delayMs) {
+    static constexpr int MAX_VERIFY_RETRIES = 10;
+    if (m_iVerifyRetries++ >= MAX_VERIFY_RETRIES) {
+        m_bVerifyRetryScheduled = false;
+        Log::logger->log(Log::WARN, "fprint: device did not come back, giving up");
+        m_sFailureReason = "Fingerprint auth disabled (device unavailable)";
+        g_pAuth->enqueueFail(m_sFailureReason, AUTH_IMPL_FINGERPRINT);
+        return;
+    }
+
+    m_bRecreateDeviceOnRetry = m_bRecreateDeviceOnRetry || recreateDevice;
+    if (m_bVerifyRetryScheduled)
+        return;
+    m_bVerifyRetryScheduled = true;
+    const auto retryGeneration = ++m_iVerifyRetryGeneration;
+    g_pHyprlock->addTimer(
+        std::chrono::milliseconds(delayMs),
+        [retryGeneration](ASP<CTimer> self, void* data) {
+            auto* fprint = static_cast<CFingerprint*>(data);
+            if (retryGeneration != fprint->m_iVerifyRetryGeneration)
+                return;
+            fprint->m_bVerifyRetryScheduled = false;
+            if (fprint->m_bRecreateDeviceOnRetry) {
+                fprint->m_bRecreateDeviceOnRetry = false;
+                if (fprint->m_bDeviceClaimed)
+                    fprint->releaseDevice();
+                fprint->resetFingerprintConnection();
+            }
+            if (fprint->m_bDeviceClaimed) {
+                fprint->stopVerify([fprint] {
+                    if (!fprint->m_sDBUSState.sleeping && !fprint->m_sDBUSState.done)
+                        fprint->startVerify();
+                });
+                return;
+            }
+            fprint->startVerify();
+        },
+        this);
+}
