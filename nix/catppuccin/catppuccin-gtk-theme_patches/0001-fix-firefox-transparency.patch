From: bitbloxhub <45184892+bitbloxhub@users.noreply.github.com>
Date: Fri, 23 Jan 2026 19:35:22 +0000
Subject: [PATCH] fix: firefox transparency

---
 themes/src/sass/gtk3/widgets/_window.scss | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/themes/src/sass/gtk3/widgets/_window.scss b/themes/src/sass/gtk3/widgets/_window.scss
index 42880e21a..cdbe3dba2 100644
--- a/themes/src/sass/gtk3/widgets/_window.scss
+++ b/themes/src/sass/gtk3/widgets/_window.scss
@@ -16,7 +16,9 @@ decoration {
 			.background.csd & {
 				border: 1px solid highlight($background);
 				background-clip: border-box;
-				background-color: $background;
+				/* firefox transparency fix */
+				/* background-color: $background; */
+				background-color: transparent;
 			}
 		}
 	}
